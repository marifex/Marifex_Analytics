<div
  class="marifex-dashboard"
  data-marifex-dashboard
  data-metric-endpoint="{{ metric_endpoint|e('html_attr') }}"
  data-insight-endpoint="{{ insight_endpoint|e('html_attr') }}"
  data-definition-endpoint="{{ definition_endpoint|e('html_attr') }}"
  data-palette-endpoint="{{ palette_endpoint|e('html_attr') }}"
  data-csrf-token="{{ csrf_token(true)|e('html_attr') }}"
  data-ticket-search-url="{{ ticket_drilldown_url|e('html_attr') }}"
  data-asset-search-url="{{ asset_search_url|e('html_attr') }}"
  data-licence-search-url="{{ licence_search_url|e('html_attr') }}"
  data-change-search-url="{{ change_search_url|e('html_attr') }}"
  data-problem-search-url="{{ problem_search_url|e('html_attr') }}"
  data-report-export-url="{{ report_export_url|e('html_attr') }}"
  data-report-schedule-endpoint="{{ report_schedule_endpoint|e('html_attr') }}"
  data-can-export="{{ can_export ? '1' : '0' }}"
  data-can-schedule="{{ can_schedule ? '1' : '0' }}"
  dir="auto"
>
  <div class="marifex-dashboard__loading" role="status">
    {{ __('Loading analytics...', 'marifex') }}
  </div>
</div>
