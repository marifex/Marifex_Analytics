{% extends "layout/page_without_tabs.html.twig" %}

{% set title = __('MarifeX configuration', 'marifex') %}

{% block content_title %}{{ title }}{% endblock %}

{% block content_body %}
  <form method="post" action="{{ path('marifex_settings') }}" class="card">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <div class="card-header">
      <h1 class="card-title">{{ __('MarifeX configuration', 'marifex') }}</h1>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="marifex-etl-batch-size">{{ __('ETL batch size', 'marifex') }}</label>
          <input id="marifex-etl-batch-size" class="form-control" type="number" name="etl_batch_size" min="50" max="5000" step="50" value="{{ config.etl_batch_size|default(500) }}" required>
          <div class="form-hint">{{ __('Records processed by each incremental pipeline run (50 to 5,000).', 'marifex') }}</div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="marifex-snapshot-timezone">{{ __('Snapshot timezone', 'marifex') }}</label>
          <select id="marifex-snapshot-timezone" class="form-select" name="snapshot_timezone" required>
            {% for timezone in timezones %}
              <option value="{{ timezone }}" {{ timezone == config.snapshot_timezone|default('UTC') ? 'selected' : '' }}>{{ timezone }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="col-12">
          <label class="form-check form-switch">
            <input class="form-check-input" type="checkbox" name="retain_analytics_on_uninstall" value="1" {{ config.retain_analytics_on_uninstall|default(1) ? 'checked' : '' }}>
            <span class="form-check-label">{{ __('Retain analytics data when the plugin is uninstalled', 'marifex') }}</span>
          </label>
          <div class="form-hint">{{ __('Recommended. Turning this off causes plugin-owned analytics tables to be removed during uninstall; GLPI operational tables are never removed.', 'marifex') }}</div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="marifex-report-retention">{{ __('Report retention', 'marifex') }}</label>
          <div class="input-group"><input id="marifex-report-retention" class="form-control" type="number" name="report_retention_days" min="1" max="365" value="{{ config.report_retention_days|default(30) }}" required><span class="input-group-text">{{ __('days') }}</span></div>
          <div class="form-hint">{{ __('Generated report files are removed after this period; immutable run history remains available.', 'marifex') }}</div>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="marifex-headless-browser">{{ __('Headless browser executable', 'marifex') }}</label>
          <input id="marifex-headless-browser" class="form-control" type="text" name="headless_browser_path" value="{{ config.headless_browser_path|default('') }}" placeholder="{{ report_engine.path|default('Auto-detect Chrome or Edge') }}">
          <div class="form-hint"><span class="badge {{ report_engine.available ? 'bg-green-lt' : 'bg-red-lt' }}">{{ report_engine.available ? __('PDF engine ready', 'marifex') : __('PDF engine unavailable', 'marifex') }}</span></div>
        </div>
      </div>
    </div>
    <div class="card-footer text-end">
      <button class="btn btn-primary" type="submit">{{ _x('button', 'Save') }}</button>
    </div>
  </form>

  <div class="card mt-3">
    <div class="card-header"><h2 class="card-title">{{ __('Pipeline health', 'marifex') }}</h2></div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ __('Pipeline', 'marifex') }}</th><th>{{ __('Source', 'marifex') }}</th><th>{{ __('Status') }}</th><th>{{ __('Watermark', 'marifex') }}</th><th>{{ __('Last error', 'marifex') }}</th></tr></thead>
        <tbody>
          {% for pipeline in pipelines %}
            <tr>
              <td><code>{{ pipeline.pipeline }}</code></td>
              <td>{{ pipeline.source_table }}</td>
              <td><span class="badge {{ pipeline.status == 'failed' ? 'bg-red-lt' : (pipeline.status == 'running' ? 'bg-yellow-lt' : 'bg-green-lt') }}">{{ pipeline.status }}</span></td>
              <td>{{ pipeline.watermark_date|default('Not started') }} / #{{ pipeline.watermark_id }}</td>
              <td>{{ pipeline.last_error|default('None') }}</td>
            </tr>
          {% else %}
            <tr><td colspan="5" class="text-secondary">{{ __('No ETL pipeline has run yet.', 'marifex') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header"><h2 class="card-title">{{ __('Verified event mappings', 'marifex') }}</h2></div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ __('Event', 'marifex') }}</th><th>{{ __('GLPI field', 'marifex') }}</th><th>{{ __('Search option', 'marifex') }}</th><th>{{ __('GLPI version', 'marifex') }}</th><th>{{ __('Status') }}</th></tr></thead>
        <tbody>
          {% for mapping in mappings %}
            <tr>
              <td><code>{{ mapping.semantic_event }}</code></td>
              <td>{{ mapping.source_field }}</td>
              <td>#{{ mapping.search_option_id }}</td>
              <td>{{ mapping.glpi_version_min }}</td>
              <td><span class="badge {{ mapping.validation_status == 'verified' ? 'bg-green-lt' : 'bg-red-lt' }}">{{ mapping.validation_status }}</span></td>
            </tr>
          {% else %}
            <tr><td colspan="5" class="text-secondary">{{ __('No event mapping has been verified yet.', 'marifex') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">
      <div>
        <h2 class="card-title">{{ __('Certified analytics health', 'marifex') }}</h2>
        <div class="text-secondary mt-1">{{ __('Certified asset, licence, change and problem metrics available to Home dashboards in the active entity scope.', 'marifex') }}</div>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ __('Domain', 'marifex') }}</th><th>{{ __('Certified metric', 'marifex') }}</th><th>{{ __('Latest snapshot', 'marifex') }}</th><th>{{ __('Stored grains', 'marifex') }}</th><th>{{ __('Status') }}</th></tr></thead>
        <tbody>
          {% for metric in phase4_metrics %}
            <tr>
              <td>{{ metric.domain }}</td>
              <td><div>{{ metric.label }}</div><code>{{ metric.metric }}</code></td>
              <td>{{ metric.latest_date|default(__('Not available', 'marifex')) }}</td>
              <td>{{ metric.grain_count }}</td>
              <td><span class="badge {{ metric.status == 'current' ? 'bg-green-lt' : (metric.status == 'live' ? 'bg-blue-lt' : (metric.status == 'stale' ? 'bg-yellow-lt' : 'bg-red-lt')) }}">{{ metric.status }}</span></td>
            </tr>
          {% else %}
            <tr><td colspan="5" class="text-secondary">{{ __('Phase 4 analytics schema is not available.', 'marifex') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header"><h2 class="card-title">{{ __('Recent reconciliation checks', 'marifex') }}</h2></div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ __('Scope', 'marifex') }}</th><th>{{ __('Completed', 'marifex') }}</th><th>{{ __('Source', 'marifex') }}</th><th>{{ __('Analytics', 'marifex') }}</th><th>{{ __('Missing', 'marifex') }}</th><th>{{ __('Orphans', 'marifex') }}</th><th>{{ __('Status') }}</th></tr></thead>
        <tbody>
          {% for run in reconciliations %}
            <tr>
              <td>{{ run.scope }}</td><td>{{ run.completed_at }}</td><td>{{ run.source_count }}</td><td>{{ run.analytics_count }}</td><td>{{ run.missing_count }}</td><td>{{ run.orphan_count }}</td>
              <td><span class="badge {{ run.status == 'passed' ? 'bg-green-lt' : (run.status == 'failed' ? 'bg-red-lt' : 'bg-yellow-lt') }}">{{ run.status }}</span></td>
            </tr>
          {% else %}
            <tr><td colspan="7" class="text-secondary">{{ __('No reconciliation check has run yet.', 'marifex') }}</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-3">
    <div class="card-header">
      <div><h2 class="card-title">{{ __('Scheduled reporting and export history', 'marifex') }}</h2><div class="text-secondary mt-1">{{ __('Governed Phase 5 report generation in the active entity scope.', 'marifex') }}</div></div>
    </div>
    <div class="table-responsive">
      <table class="table table-vcenter card-table">
        <thead><tr><th>{{ __('Started', 'marifex') }}</th><th>{{ __('Format', 'marifex') }}</th><th>{{ __('Status') }}</th><th>{{ __('Recipients', 'marifex') }}</th><th>{{ __('Result', 'marifex') }}</th></tr></thead>
        <tbody>
          {% for run in report_runs %}
            <tr>
              <td>{{ run.started_at }}</td><td>{{ run.format|upper }}</td>
              <td><span class="badge {{ run.status == 'completed' ? 'bg-green-lt' : (run.status == 'running' ? 'bg-yellow-lt' : 'bg-red-lt') }}">{{ run.status }}</span></td>
              <td>{{ run.recipient_count }}</td>
              <td>{% if run.status == 'completed' and run.file_path %}<a href="{{ report_file_url }}/{{ run.id }}">{{ run.file_name }}</a>{% else %}<span class="text-secondary">{{ run.error_message|default(__('No file', 'marifex')) }}</span>{% endif %}</td>
            </tr>
          {% else %}<tr><td colspan="5" class="text-secondary">{{ __('No report has been generated yet.', 'marifex') }}</td></tr>{% endfor %}
        </tbody>
      </table>
    </div>
  </div>
{% endblock %}
